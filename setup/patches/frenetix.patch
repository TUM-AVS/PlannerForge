+def determine_collision_type(agent, scenario, timestep):
+    """
+    Determine the type of collision based on the relative position of colliding vehicles.
+    
+    :param agent: The ego agent that collided
+    :param scenario: The scenario object
+    :param timestep: The timestep when collision occurred
+    :return: Tuple (collision_type, colliding_object_id) where collision_type is string and colliding_object_id is int or None
+    """
+    try:
+        # Get ego vehicle position and orientation at collision time
+        ego_state = agent.record_state_list[-1] if agent.record_state_list else None
+        if ego_state is None:
+            return ("unknown", None)
+                
+        ego_pos = np.array([ego_state.position[0], ego_state.position[1]])
+        ego_orientation = ego_state.orientation
+            
+        # Vehicle dimensions (typical values)
+        ego_length = 4.508
+        ego_width = 1.610
+            
+        # Track closest colliding vehicle
+        closest_distance = float('inf')
+        closest_obs_id = None
+        closest_collision_type = None
+            
+        # Check collision with other vehicles
+        for obs in scenario.dynamic_obstacles:
+            if obs.obstacle_id == agent.id:
+                continue
+                        
+            try:
+                # Get obstacle state at collision time
+                obs_state = obs.state_at_time(timestep)
+                if obs_state is None:
+                    continue
+                                
+                obs_pos = np.array([obs_state.position[0], obs_state.position[1]])
+                            
+                # Calculate relative position
+                relative_pos = obs_pos - ego_pos
+                distance = np.linalg.norm(relative_pos)
+                            
+                # Check if this obstacle is close enough to be the colliding one
+                if distance > 10.0:  # Too far to be the colliding vehicle
+                    continue
+                            
+                # Transform to ego vehicle's local coordinate system
+                cos_theta = np.cos(-ego_orientation)
+                sin_theta = np.sin(-ego_orientation)
+                rotation_matrix = np.array([[cos_theta, -sin_theta],
+                                           [sin_theta, cos_theta]])
+                local_relative_pos = rotation_matrix @ relative_pos
+                            
+                d_long = local_relative_pos[0]  # Longitudinal distance (front/rear)
+                d_lat = local_relative_pos[1]   # Lateral distance (left/right)
+                            
+                # Determine collision direction based on relative position
+                front_threshold = ego_length / 2
+                rear_threshold = -ego_length / 2
+                side_threshold = ego_width / 2
+                            
+                collision_type = None
+                if d_long > front_threshold:
+                    collision_type = "front_collision"  # Ego hit from front (ego's fault)
+                elif d_long < rear_threshold:
+                    collision_type = "rear_collision"   # Ego hit from rear (usually not ego's fault)
+                elif abs(d_lat) > side_threshold:
+                    collision_type = "side_collision"   # Side impact
+                else:
+                    collision_type = "front_collision"  # Default to front if unclear
+                            
+                # Keep track of the closest colliding vehicle
+                if distance < closest_distance:
+                    closest_distance = distance
+                    closest_obs_id = obs.obstacle_id
+                    closest_collision_type = collision_type
+                            
+            except Exception:
+                continue
+            
+        # Return the collision info for the closest vehicle
+        if closest_obs_id is not None:
+            return (closest_collision_type, closest_obs_id)
+            
+        # If no dynamic obstacle collision found, check for boundary collision
+        return ("boundary_collision", None)
+        
+    except Exception:
+        return ("unknown", None)
+

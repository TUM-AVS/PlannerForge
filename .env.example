# Copy to `.env` and fill in what you use. Never commit `.env`.

# --- Conda / environments --------------------------------------------------
# Absolute path to your conda executable (used to launch the CommonRoad/SUMO
# toolchain as subprocesses).
CONDA_BIN=/home/<user>/miniconda3/bin/conda
# Name of the conda env built from environment-cr37.yml (see setup/install.md)
CR_CONDA_ENV=cr37
OSM_CONDA_ENV=cr37
# Python interpreter of the MP-RBFN planner environment (only needed when
# running the MP-RBFN planner; see setup/install.md §4)
MPRBFN_PYTHON=python3

# --- Default LLM provider --------------------------------------------------
# commercial = Google Gemini (DEFAULT_API_KEY is passed to ChatGoogleGenerativeAI)
# ollama     = local open-weight models
# For any other hosted provider use the QWEN_* (OpenAI-compatible) slot below.
DEFAULT_MODE=commercial
DEFAULT_API_KEY=
DEFAULT_API_MODEL=gemini-2.5-flash
DEFAULT_OLLAMA_MODEL=qwen3:30b
DEFAULT_OLLAMA_URL=http://localhost:11434

# --- Qwen / DashScope (OpenAI-compatible endpoint) -------------------------
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Any other OpenAI-compatible endpoint (OpenAI, DeepSeek, GLM, ...) is reached
# through the QWEN_* slot above: set QWEN_BASE_URL to the provider's endpoint,
# QWEN_MODEL to the model id, and QWEN_API_KEY to your key. There are no
# per-provider variables — the app passes the key it is given explicitly.

# --- Optional scenario-generation limits ----------------------------------
# MAX_BBOX_KM2=
# MAX_XODR_MB=
